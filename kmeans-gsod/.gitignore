# Virtual environment
.venv/
venv/

# Cached NOAA station downloads. Excluded deliberately: the data is public and
# the application re-fetches it on demand, so committing ~25 MB of CSV would add
# nothing but weight to the repository.
data/

# outputs/ is deliberately COMMITTED, not ignored. It holds the four figures, the
# labelled station table, the k-selection diagnostics and the test log, so a
# reader can see the results without installing anything or waiting for a 25 MB
# download. It is small (about 650 KB) and regenerated by `python -m src.main`.

# Python
__pycache__/
*.py[cod]
*.egg-info/
.pytest_cache/
.coverage
htmlcov/

